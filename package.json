{
	"name": "web2gem",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"main": "dist/app.js",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check:static": "biome check --assist-enabled=false --diagnostic-level=warn --error-on-warnings",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
		"check:test-types": "node scripts/check-test-types.mjs",
		"check:arch": "node scripts/check-architecture.mjs",
		"check:size": "pnpm build && node scripts/check-bundle-size.mjs",
		"check:bench": "node scripts/build.mjs --harness-bundle && node scripts/check-benchmark.mjs",
		"check:release": "node scripts/check-release.mjs",
		"unit": "vitest run",
		"coverage": "node scripts/coverage.mjs",
		"coverage:ci": "node scripts/coverage.mjs --ci",
		"smoke": "node scripts/build.mjs --harness-bundle && node scripts/smoke.mjs",
		"docker:smoke": "node scripts/docker-smoke.mjs",
		"bench": "node scripts/build.mjs --harness-bundle && node scripts/bench.mjs",
		"docker:start": "node server/docker-server.mjs",
		"dev": "pnpm build && node server/docker-server.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@preact/signals": "^2.9.3",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"preact": "^10.29.7",
		"typescript": "^7.0.2",
		"valibot": "^1.4.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"playwright-core": "1.62.1"
	}
}
