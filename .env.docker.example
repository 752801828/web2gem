# Host port exposed by Docker Compose.
PORT=52389

# Docker image used by Docker Compose. Override this to pin a release tag.
WEB2GEM_IMAGE=web2gem-account-pool:local
BROWSER_HELPER_IMAGE=web2gem-browser-helper:local

# The local SQLite account database lives in the named Compose volume at /data.
SQLITE_PATH=/data/web2gem.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000

# Create this file locally with one random 32-byte base64 key. Never commit it.
WEB2GEM_MASTER_KEY_FILE=./secrets/web2gem_master_key

# Browser helper. Keep the token distinct from ADMIN_KEY.
NOVNC_PORT=6080
BROWSER_HELPER_INTERNAL_TOKEN=
NOVNC_PASSWORD=
NOVNC_PUBLIC_URL=
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
BROWSER_CHECK_INTERVAL_SEC=
BROWSER_CHECK_JITTER_SEC=
BROWSER_VISIBLE_IDLE_TIMEOUT_SEC=
BROWSER_VISIBLE_SUBMISSION_TIMEOUT_SEC=
BROWSER_AUTLOGIN_MAX_ATTEMPTS_PER_DAY=
BROWSER_MAX_CLOCK_SKEW_SEC=

# Optional shared outbound proxy. NO_PROXY must retain the Compose service names.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=web2gem,browser-helper,127.0.0.1,localhost,::1

# Optional auth. Empty API_KEYS disables authentication.
API_KEYS=

# Optional account-pool admin auth. Admin endpoints fail closed when this is
# empty. Use one strong key and do not use placeholder values such as changeme.
ADMIN_KEY=

# Optional runtime overrides.
GEMINI_BL=
GEMINI_ORIGIN=
DEFAULT_MODEL=gemini-3.5-flash
RETRY_ATTEMPTS=
GEMINI_ACCOUNT_MAX_ATTEMPTS=
GEMINI_ACCOUNT_REFRESH_INTERVAL_SEC=
GEMINI_ACCOUNT_CAPABILITY_TTL_SEC=
GEMINI_ACCOUNT_CAPABILITY_MODE=
RETRY_DELAY_SEC=
REQUEST_TIMEOUT_SEC=
REQUEST_BODY_MAX_BYTES=67108864
LOG_REQUESTS=
CURRENT_INPUT_FILE_ENABLED=
CURRENT_INPUT_FILE_MIN_BYTES=
GENERIC_FILE_UPLOAD_MAX_BYTES=
